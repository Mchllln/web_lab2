<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: #f0f2f5;
      color: #333;
      min-height: 100vh;
    }

    nav {
      background: #1a1a2e;
      padding: 0 2rem;
      display: flex;
      align-items: center;
      gap: 2rem;
      height: 56px;
    }
    nav .brand { color: #e94560; font-weight: 700; font-size: 1.2rem; text-decoration: none; }
    nav a { color: #ccc; text-decoration: none; font-size: 0.9rem; transition: color 0.2s; }
    nav a:hover { color: #fff; }

    main { max-width: 1100px; margin: 2rem auto; padding: 0 1.5rem; }

    h1 { font-size: 1.6rem; margin-bottom: 1.5rem; color: #1a1a2e; }

    .btn {
      display: inline-flex; align-items: center; gap: 0.4rem;
      padding: 0.45rem 1rem; border-radius: 6px; border: none;
      font-size: 0.85rem; font-weight: 600; cursor: pointer;
      text-decoration: none; transition: opacity 0.15s;
    }
    .btn:hover { opacity: 0.85; }
    .btn-primary  { background: #e94560; color: #fff; }
    .btn-secondary{ background: #16213e; color: #fff; }
    .btn-danger   { background: #dc3545; color: #fff; }
    .btn-success  { background: #28a745; color: #fff; }
    .btn-outline  { background: transparent; color: #16213e; border: 2px solid #16213e; }
    .btn-sm { padding: 0.3rem 0.7rem; font-size: 0.78rem; }

    .card {
      background: #fff;
      border-radius: 10px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      padding: 2rem;
    }

    .alert-error {
      background: #ffeaea; border: 1px solid #f5c6cb;
      color: #721c24; border-radius: 6px; padding: 0.75rem 1rem;
      margin-bottom: 1rem; font-size: 0.9rem;
    }
  </style>
</head>
<body>
<nav>
  <a class="brand" href="/cars">🚗 AutoHub</a>
  <a href="/cars">All Cars</a>
  <a href="/cars/new">+ Add Car</a>
</nav>
<main>
