<%- include('../partials/header') %>

<%-- Single multipurpose form page – used for Create, View, and Edit --%>
<div style="max-width:600px; margin:0 auto;">

  <div style="display:flex; align-items:center; gap:1rem; margin-bottom:1.5rem;">
    <a href="/cars" class="btn btn-outline btn-sm">← Back</a>
    <h1 style="margin:0;"><%= car ? `Edit Car #${car.id}` : 'Add New Car' %></h1>
  </div>

  <% if (errors && errors.length > 0) { %>
    <div class="alert-error">
      <% errors.forEach(e => { %><div>⚠ <%= e %></div><% }) %>
    </div>
  <% } %>

  <div class="card">
    <%-- Use PUT for edit, POST for create (method-override) --%>
    <form
      action="<%= car ? `/cars/${car.id}?_method=PUT` : '/cars' %>"
      method="POST"
    >
      <div style="display:grid; gap:1.2rem;">

        <div>
          <label style="display:block; font-weight:600; margin-bottom:0.4rem;">Model</label>
          <input
            type="text" name="model"
            value="<%= car ? car.model : '' %>"
            placeholder="e.g. Camry"
            required
            style="width:100%; padding:0.55rem 0.75rem; border:1.5px solid #ddd; border-radius:6px; font-size:0.95rem;"
          />
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
          <div>
            <label style="display:block; font-weight:600; margin-bottom:0.4rem;">Year</label>
            <input
              type="number" name="year"
              value="<%= car ? car.year : '' %>"
              min="1900" max="2099" placeholder="2023"
              required
              style="width:100%; padding:0.55rem 0.75rem; border:1.5px solid #ddd; border-radius:6px; font-size:0.95rem;"
            />
          </div>
          <div>
            <label style="display:block; font-weight:600; margin-bottom:0.4rem;">Price ($)</label>
            <input
              type="number" name="price"
              value="<%= car ? car.price : '' %>"
              min="0" step="100" placeholder="25000"
              required
              style="width:100%; padding:0.55rem 0.75rem; border:1.5px solid #ddd; border-radius:6px; font-size:0.95rem;"
            />
          </div>
        </div>

        <div>
          <label style="display:block; font-weight:600; margin-bottom:0.4rem;">Color</label>
          <input
            type="text" name="color"
            value="<%= car ? car.color : '' %>"
            placeholder="e.g. Red"
            required
            style="width:100%; padding:0.55rem 0.75rem; border:1.5px solid #ddd; border-radius:6px; font-size:0.95rem;"
          />
        </div>

        <%--
          Lab requirement: auxiliary entity (Brand) must be shown FULLY on this page.
          The dropdown displays all brand fields: id, name, country, founded year.
        --%>
        <div>
          <label style="display:block; font-weight:600; margin-bottom:0.4rem;">Brand</label>
          <select
            name="brandId"
            required
            style="width:100%; padding:0.55rem 0.75rem; border:1.5px solid #ddd; border-radius:6px; font-size:0.95rem; background:#fff;"
          >
            <option value="">— Select a brand —</option>
            <% brands.forEach(brand => { %>
              <option
                value="<%= brand.id %>"
                <%= (car && car.brandId === brand.id) ? 'selected' : '' %>
              >
                #<%= brand.id %> &nbsp;|&nbsp; <%= brand.name %> &nbsp;|&nbsp; <%= brand.country %> &nbsp;|&nbsp; est. <%= brand.foundedYear %>
              </option>
            <% }) %>
          </select>
          <p style="font-size:0.78rem; color:#888; margin-top:0.3rem;">
            Format: ID | Name | Country | Founded year
          </p>
        </div>

        <div style="display:flex; gap:1rem; margin-top:0.5rem;">
          <button type="submit" class="btn btn-success">
            <%= car ? '💾 Save Changes' : '➕ Create Car' %>
          </button>
          <a href="/cars" class="btn btn-outline">Cancel</a>
        </div>

      </div>
    </form>
  </div>

  <% if (car) { %>
  <div class="card" style="margin-top:1.5rem; background:#f8f9fa;">
    <h2 style="font-size:1rem; margin-bottom:1rem; color:#555;">Current Brand Details</h2>
    <table style="font-size:0.88rem; border-collapse:collapse; width:100%;">
      <tr><th style="text-align:left; padding:0.4rem 0.8rem; color:#888;">Field</th><th style="text-align:left; padding:0.4rem 0.8rem;">Value</th></tr>
      <tr style="border-top:1px solid #eee;"><td style="padding:0.4rem 0.8rem; color:#888;">ID</td><td style="padding:0.4rem 0.8rem;"><%= car.Brand.id %></td></tr>
      <tr style="border-top:1px solid #eee;"><td style="padding:0.4rem 0.8rem; color:#888;">Name</td><td style="padding:0.4rem 0.8rem;"><strong><%= car.Brand.name %></strong></td></tr>
      <tr style="border-top:1px solid #eee;"><td style="padding:0.4rem 0.8rem; color:#888;">Country</td><td style="padding:0.4rem 0.8rem;"><%= car.Brand.country %></td></tr>
      <tr style="border-top:1px solid #eee;"><td style="padding:0.4rem 0.8rem; color:#888;">Founded</td><td style="padding:0.4rem 0.8rem;"><%= car.Brand.foundedYear %></td></tr>
    </table>
  </div>
  <% } %>

</div>

<%- include('../partials/footer') %>
