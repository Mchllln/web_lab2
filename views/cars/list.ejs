<%- include('../partials/header') %>

<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1.5rem;">
  <h1>Car Inventory</h1>
  <a href="/cars/new" class="btn btn-primary">+ Add Car</a>
</div>

<div class="card" style="padding:0; overflow:hidden;">
  <table style="width:100%; border-collapse:collapse; font-size:0.9rem;">
    <thead style="background:#1a1a2e; color:#fff;">
      <tr>
        <th style="padding:0.9rem 1.2rem; text-align:left;">ID</th>
        <th style="padding:0.9rem 1.2rem; text-align:left;">Model</th>
        <th style="padding:0.9rem 1.2rem; text-align:left;">Year</th>
        <th style="padding:0.9rem 1.2rem; text-align:left;">Price ($)</th>
        <th style="padding:0.9rem 1.2rem; text-align:left;">Color</th>
        <%-- Lab requirement: auxiliary entity shown partially (brand id only) on list page --%>
        <th style="padding:0.9rem 1.2rem; text-align:left;">Brand ID</th>
        <th style="padding:0.9rem 1.2rem; text-align:center;">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (cars.length === 0) { %>
        <tr>
          <td colspan="7" style="padding:2rem; text-align:center; color:#888;">
            No cars found. <a href="/cars/new">Add the first one!</a>
          </td>
        </tr>
      <% } else { %>
        <% cars.forEach((car, i) => { %>
          <tr style="background:<%= i % 2 === 0 ? '#fff' : '#f8f9fa' %>; border-bottom:1px solid #eee;">
            <td style="padding:0.75rem 1.2rem;"><%= car.id %></td>
            <td style="padding:0.75rem 1.2rem; font-weight:600;"><%= car.model %></td>
            <td style="padding:0.75rem 1.2rem;"><%= car.year %></td>
            <td style="padding:0.75rem 1.2rem;">$<%= car.price.toLocaleString() %></td>
            <td style="padding:0.75rem 1.2rem;">
              <span style="display:inline-flex; align-items:center; gap:0.4rem;">
                <span style="width:12px;height:12px;border-radius:50%;background:<%= car.color.toLowerCase() %>;border:1px solid #ccc;display:inline-block;"></span>
                <%= car.color %>
              </span>
            </td>
            <%-- Only brand id displayed here, as per lab requirement --%>
            <td style="padding:0.75rem 1.2rem; color:#888;">#<%= car.brandId %></td>
            <td style="padding:0.75rem 1.2rem; text-align:center;">
              <a href="/cars/<%= car.id %>" class="btn btn-secondary btn-sm">Edit</a>

              <%-- DELETE via hidden form + method-override --%>
              <form action="/cars/<%= car.id %>?_method=DELETE" method="POST"
                    style="display:inline;"
                    onsubmit="return confirm('Delete <%= car.model %>?')">
                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</div>

<p style="margin-top:1rem; color:#888; font-size:0.82rem;">
  Total records: <strong><%= cars.length %></strong>
</p>

<%- include('../partials/footer') %>
