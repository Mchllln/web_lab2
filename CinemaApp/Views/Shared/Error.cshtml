@{
    ViewData["Title"] = "Error — CinemaApp";
    Layout = "_Layout";
}

<div style="max-width:500px; margin:4rem auto; text-align:center;">
    <div style="font-size:4rem; margin-bottom:1rem;">⚠️</div>

    <h1 style="color:#e94560; font-size:1.5rem; margin-bottom:.75rem;">
        Error processing the request
    </h1>

    @* Lab requirement: show a safe, generic message — never expose the call stack *@
    <p style="color:#888; margin-bottom:2rem; line-height:1.6;">
        Something went wrong while processing your request.<br />
        Please try again or return to the ticket list.
    </p>

    <a href="/Ticket" class="btn btn-primary">← Back to Tickets</a>
</div>
