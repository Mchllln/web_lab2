<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@(ViewData["Title"] ?? "CinemaApp")</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Segoe UI', system-ui, sans-serif;
      background: #0f0f1a;
      color: #e0e0e0;
      min-height: 100vh;
    }

    /* ── Nav ─────────────────────────────────────────────────────── */
    nav {
      background: #16213e;
      padding: 0 2rem;
      height: 58px;
      display: flex;
      align-items: center;
      gap: 2rem;
      border-bottom: 2px solid #e94560;
    }
    nav .brand { color: #e94560; font-weight: 800; font-size: 1.25rem; text-decoration: none; }
    nav a { color: #aaa; text-decoration: none; font-size: 0.9rem; transition: color .2s; }
    nav a:hover { color: #fff; }

    /* ── Main container ──────────────────────────────────────────── */
    main { max-width: 1050px; margin: 2.5rem auto; padding: 0 1.5rem; }

    /* ── Alerts ──────────────────────────────────────────────────── */
    .alert {
      padding: .75rem 1.25rem; border-radius: 6px;
      margin-bottom: 1.25rem; font-size: .9rem;
    }
    .alert-success { background: #1a3a1a; color: #6fcf97; border: 1px solid #2d6a2d; }
    .alert-error   { background: #3a1a1a; color: #eb5757; border: 1px solid #6a2d2d; }

    /* ── Buttons ─────────────────────────────────────────────────── */
    .btn {
      display: inline-flex; align-items: center; gap: .35rem;
      padding: .45rem 1.1rem; border-radius: 6px; border: none;
      font-size: .85rem; font-weight: 600; cursor: pointer;
      text-decoration: none; transition: opacity .15s;
    }
    .btn:hover { opacity: .8; }
    .btn-primary  { background: #e94560; color: #fff; }
    .btn-secondary{ background: #16213e; color: #ccc; border: 1px solid #334; }
    .btn-success  { background: #27ae60; color: #fff; }
    .btn-danger   { background: #c0392b; color: #fff; }
    .btn-outline  { background: transparent; color: #aaa; border: 1.5px solid #444; }
    .btn-sm { padding: .28rem .7rem; font-size: .78rem; }

    /* ── Card ────────────────────────────────────────────────────── */
    .card {
      background: #16213e;
      border-radius: 10px;
      padding: 2rem;
      border: 1px solid #1e2d50;
    }

    /* ── Form controls ───────────────────────────────────────────── */
    .form-group { margin-bottom: 1.25rem; }
    label { display: block; font-size: .85rem; color: #aaa; margin-bottom: .35rem; font-weight: 600; }
    input[type=text], input[type=number], select {
      width: 100%; padding: .55rem .8rem;
      background: #0f0f1a; color: #e0e0e0;
      border: 1.5px solid #2a3a5e; border-radius: 6px;
      font-size: .95rem;
    }
    input:focus, select:focus { outline: none; border-color: #e94560; }
    input[readonly], select[disabled] { opacity: .6; cursor: default; }
    .field-validation-error { color: #eb5757; font-size: .8rem; display: block; margin-top: .25rem; }
    .input-validation-error { border-color: #c0392b !important; }

    /* ── Table ───────────────────────────────────────────────────── */
    table { width: 100%; border-collapse: collapse; font-size: .9rem; }
    thead { background: #1a2a4a; }
    th { padding: .9rem 1.1rem; text-align: left; color: #aaa; font-weight: 600; font-size: .8rem; text-transform: uppercase; letter-spacing: .05em; }
    td { padding: .75rem 1.1rem; border-bottom: 1px solid #1a2a3a; vertical-align: middle; }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: #1a2540; }

    footer { text-align: center; padding: 2rem; color: #555; font-size: .8rem; margin-top: 3rem; }
  </style>
</head>
<body>
  <nav>
    <a class="brand" href="/Ticket">🎬 CinemaApp</a>
    <a href="/Ticket">All Tickets</a>
    <a href="/Ticket/Create">+ New Ticket</a>
  </nav>

  <main>
    @if (TempData["Success"] is string success)
    {
      <div class="alert alert-success">✓ @success</div>
    }
    @RenderBody()
  </main>

  <footer>Lab 2 — Cinema CRUD · ASP.NET Core MVC · EF Core + SQLite</footer>
</body>
</html>
