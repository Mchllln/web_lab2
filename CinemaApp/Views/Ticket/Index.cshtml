@model IEnumerable<Ticket>
@{
    ViewData["Title"] = "Tickets — CinemaApp";
}

<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1.5rem;">
    <h1 style="font-size:1.6rem; color:#e94560;">🎟 Ticket List</h1>
    <a asp-action="Create" class="btn btn-primary">+ New Ticket</a>
</div>

<div class="card" style="padding:0; overflow:hidden;">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Customer Name</th>
                <th>Seat</th>
                <th>Price</th>
                @* Lab requirement: auxiliary entity shown PARTIALLY on list page (movie title only) *@
                <th>Showtime</th>
                <th style="text-align:center;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" style="text-align:center; padding:2.5rem; color:#555;">
                        No tickets yet. <a asp-action="Create" style="color:#e94560;">Create the first one.</a>
                    </td>
                </tr>
            }
            @foreach (var t in Model)
            {
                <tr>
                    <td style="color:#555;">#@t.Id</td>
                    <td style="font-weight:600;">@t.CustomerName</td>
                    <td>@t.SeatNumber</td>
                    <td style="color:#6fcf97;">$@t.Price.ToString("F2")</td>
                    @* Only movie title (partial) — Showtime ID also shown as spec says "e.g. id" *@
                    <td>
                        <span style="color:#aaa; font-size:.78rem;">#@t.ShowtimeId</span>
                        <span style="margin-left:.4rem;">@t.Showtime?.MovieTitle</span>
                    </td>
                    <td style="text-align:center; white-space:nowrap;">
                        <a asp-action="Details" asp-route-id="@t.Id" class="btn btn-secondary btn-sm">View</a>
                        <a asp-action="Edit"    asp-route-id="@t.Id" class="btn btn-outline btn-sm">Edit</a>
                        <form asp-action="Delete" asp-route-id="@t.Id" method="post" style="display:inline;"
                              onsubmit="return confirm('Delete ticket #@t.Id for @t.CustomerName?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<p style="margin-top:1rem; color:#555; font-size:.82rem;">
    Total records: <strong style="color:#aaa;">@Model.Count()</strong>
</p>
